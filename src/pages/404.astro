---
import Site from "../layouts/Site.astro"
---

<Site title="404 · Kameron Comer">
  <section class="relative overflow-hidden px-4 pt-40 pb-32 md:px-8">
    <div class="pointer-events-none absolute -top-40 -right-40 size-[32rem] rounded-full bg-pop/20 blur-3xl"></div>
    <div class="relative mx-auto max-w-7xl">
      <p class="font-mono text-sm text-muted">HTTP/1.1 404 Not Found</p>
      <h1 class="mt-6 font-display text-[clamp(6rem,24vw,18rem)] leading-[0.8] font-bold tracking-tighter">
        4<span class="text-pop">0</span>4
      </h1>
      <p class="mt-8 max-w-xl text-xl text-muted">
        This route never got elected leader. Try the home page, or press
        <kbd class="rounded-md border border-line px-1.5 font-mono text-sm">⌘K</kbd> to jump anywhere.
      </p>
      <a
        href="/"
        class="mt-8 inline-block rounded-full bg-fg px-6 py-3 font-semibold text-bg transition-transform hover:scale-105"
      >
        Take me home
      </a>
    </div>
  </section>
</Site>
