---
import { profile, roles } from "../../data/profile"
---

<section id="journey" class="border-t border-line px-4 py-24 md:px-8 md:py-32">
  <div class="mx-auto grid max-w-7xl gap-16 lg:grid-cols-[1fr_1.6fr]">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <h2 class="reveal font-display text-5xl font-bold tracking-tight md:text-7xl">
        From circuits to clusters.
      </h2>
      {profile.bio.map((p) => <p class="reveal mt-6 text-lg text-muted">{p}</p>)}
    </div>

    <ol class="space-y-4">
      {
        roles.map((r) => (
          <li class="reveal group rounded-3xl border border-line p-6 transition-colors hover:border-fg md:p-8">
            <span class="font-display text-sm font-semibold text-muted">
              {r.start === r.end ? r.start : `${r.start}—${r.end}`}
              {r.kind === "education" && " · Education"}
            </span>
            <h3 class="mt-3 font-display text-3xl font-bold tracking-tight md:text-4xl">
              {r.company}
            </h3>
            <p class="mt-1 font-medium">{r.title}</p>
            <p class="mt-4 text-muted">{r.summary}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {r.tech.map((t) => (
                <li class="rounded-full bg-bg-2 px-3 py-1 text-xs font-medium">{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
