---
import { Image } from "astro:assets"
import { links, projects, sideProjects, yearsShipping } from "../../data/profile"
import { getGithubStats } from "../../lib/github"

const [kv, http, movies] = projects
const stats = await getGithubStats()
const langs = stats.languages.slice(0, 5)
const langTotal = langs.reduce((sum, l) => sum + l.count, 0)
const barColors = ["bg-pop", "bg-primary", "bg-secondary", "bg-ok", "bg-muted"]

const tile = "reveal group relative overflow-hidden rounded-3xl border border-line"
---

<section id="work" class="px-4 py-24 md:px-8 md:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="reveal mb-12 flex flex-wrap items-end justify-between gap-6">
      <h2 class="font-display text-5xl font-bold tracking-tight md:text-7xl">Selected work</h2>
      <p class="max-w-sm text-muted">
        Systems I designed and built end-to-end, from consensus protocols to raw sockets.
      </p>
    </div>

    <div class="grid auto-rows-[minmax(12rem,auto)] gap-4 md:grid-cols-6">
      <!-- Flagship -->
      <a href={`${links.github}/${kv.repo}`} class:list={[tile, "bg-bg-3 md:col-span-4 md:row-span-2"]}>
        <div class="relative z-10 flex h-full flex-col p-6 md:p-8">
          <span class="w-fit rounded-full bg-pop px-3 py-1 text-xs font-semibold text-pop-ink">
            Flagship · {kv.kicker}
          </span>
          <h3 class="mt-4 font-display text-3xl font-bold tracking-tight md:text-5xl">{kv.title}</h3>
          <p class="mt-3 max-w-lg text-muted">{kv.summary}</p>
          {
            kv.image && (
              <div class="mt-6 -mr-6 -mb-6 flex-1 overflow-hidden rounded-tl-2xl border-t border-l border-line md:-mr-8 md:-mb-8">
                <Image
                  src={kv.image}
                  alt={`${kv.title} screenshot`}
                  widths={[600, 1000]}
                  sizes="(min-width: 768px) 60vw, 100vw"
                  class="size-full object-cover object-left-top transition-transform duration-700 group-hover:scale-[1.03]"
                />
              </div>
            )
          }
        </div>
      </a>

      <!-- Stat -->
      <div class:list={[tile, "flex flex-col justify-between bg-pop p-6 text-pop-ink md:col-span-2"]}>
        <span class="text-sm font-semibold">Shipping software since 2020</span>
        <span class="font-display text-8xl leading-none font-bold tracking-tighter">
          {yearsShipping}+
        </span>
        <span class="text-sm">years across automotive, embedded & platform teams</span>
      </div>

      <!-- Languages -->
      <div class:list={[tile, "flex flex-col bg-bg-3 p-6 md:col-span-2"]}>
        <span class="text-sm text-muted">On GitHub right now</span>
        <span class="mt-1 font-display text-4xl font-bold tracking-tight">
          {stats.publicRepos || "20+"} repos
        </span>
        {
          langTotal > 0 && (
            <>
              <div class="mt-auto flex h-3 overflow-hidden rounded-full">
                {langs.map((l, i) => (
                  <span class:list={[barColors[i]]} style={{ width: `${(l.count / langTotal) * 100}%` }} />
                ))}
              </div>
              <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted">
                {langs.map((l, i) => (
                  <li class="flex items-center gap-1.5">
                    <span class:list={["size-2 rounded-full", barColors[i]]} />
                    {l.name}
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>

      <!-- HTTP server -->
      <a
        href={`${links.github}/${http.repo}`}
        class:list={[tile, "flex flex-col bg-fg p-6 text-bg md:col-span-3 md:p-8"]}
      >
        <span class="text-sm opacity-60">{http.kicker}</span>
        <h3 class="mt-2 font-display text-3xl font-bold tracking-tight">{http.title}</h3>
        <p class="mt-3 opacity-70">{http.summary}</p>
        <pre
          class="mt-6 overflow-hidden rounded-xl bg-bg/10 p-4 font-mono text-xs leading-relaxed opacity-90"
          aria-hidden="true">{`$ curl -i localhost:8080
HTTP/1.1 200 OK
Connection: keep-alive`}</pre>
        <span class="mt-4 flex flex-wrap gap-2">
          {http.tags.map((t) => <span class="rounded-full border border-bg/20 px-3 py-1 text-xs">{t}</span>)}
        </span>
      </a>

      <!-- Movies -->
      <a href={`${links.github}/${movies.repo}`} class:list={[tile, "flex flex-col bg-bg-3 md:col-span-3"]}>
        {
          movies.image && (
            <img
              src={movies.image.src}
              width={movies.image.width}
              height={movies.image.height}
              alt={`${movies.title} demo`}
              loading="lazy"
              decoding="async"
              class="h-56 w-full object-cover object-top"
            />
          )
        }
        <div class="p-6 md:p-8">
          <span class="text-sm text-muted">{movies.kicker}</span>
          <h3 class="mt-1 font-display text-3xl font-bold tracking-tight">{movies.title}</h3>
          <p class="mt-2 text-muted">{movies.summary}</p>
        </div>
      </a>

      <!-- Side projects -->
      <div class:list={[tile, "bg-bg-3 p-6 md:col-span-6 md:p-8"]}>
        <h3 class="font-display text-2xl font-bold tracking-tight">Also built, for the love of it</h3>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            sideProjects.map((s) => (
              <li>
                <a
                  href={`${links.github}/${s.repo}`}
                  class="flex h-full items-start justify-between gap-4 rounded-2xl bg-bg-2 p-4 transition-colors hover:bg-pop hover:text-pop-ink"
                >
                  <span>
                    <span class="block font-semibold">{s.title}</span>
                    <span class="text-sm opacity-70">{s.summary}</span>
                  </span>
                  <span class="rounded-full border border-current/20 px-2 py-0.5 text-xs">{s.lang}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
