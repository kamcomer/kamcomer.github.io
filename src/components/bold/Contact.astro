---
import { links, profile, social } from "../../data/profile"
---

<section id="contact" class="relative overflow-hidden bg-fg px-4 py-24 text-bg md:px-8 md:py-36">
  <div class="pointer-events-none absolute -bottom-48 left-1/2 size-[40rem] -translate-x-1/2 rounded-full bg-pop/30 blur-3xl"></div>
  <div class="relative mx-auto max-w-7xl">
    <p class="reveal text-lg opacity-60">Got a hard problem? Let's talk.</p>
    <a
      href={links.email}
      class="reveal group mt-6 block font-display text-[clamp(2rem,7.5vw,7rem)] leading-none font-bold tracking-tighter break-all"
    >
      <span class="bg-gradient-to-r from-pop to-pop bg-[length:0%_6px] bg-left-bottom bg-no-repeat pb-2 transition-[background-size] duration-500 group-hover:bg-[length:100%_6px]">
        {social.email}
      </span>
    </a>
    <div class="mt-16 flex flex-wrap items-center justify-between gap-6 border-t border-bg/15 pt-8">
      <div class="flex gap-3">
        <a href={links.github} class="rounded-full border border-bg/25 px-5 py-2.5 font-semibold transition-colors hover:bg-bg hover:text-fg">
          GitHub
        </a>
        <a href={links.linkedin} class="rounded-full border border-bg/25 px-5 py-2.5 font-semibold transition-colors hover:bg-bg hover:text-fg">
          LinkedIn
        </a>
      </div>
      <p class="text-sm opacity-50">© {new Date().getFullYear()} {profile.name}</p>
    </div>
  </div>
</section>
