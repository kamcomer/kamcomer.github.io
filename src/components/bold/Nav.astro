---
import ThemeToggle from "../shared/ThemeToggle.astro"
import { links } from "../../data/profile"

const items = [
  { href: "/#work", label: "Work" },
  { href: "/#journey", label: "Journey" },
  { href: "/resume/", label: "Resume" },
]
---

<header class="fixed inset-x-0 top-4 z-40 flex justify-center px-4 print:hidden">
  <nav
    class="flex w-full max-w-3xl items-center gap-1 rounded-full border border-line bg-bg/75 p-1.5 pl-5 shadow-lg shadow-black/5 backdrop-blur-xl"
  >
    <a href="/" class="mr-auto font-display text-lg font-bold tracking-tight">KC.</a>
    {
      items.map((item) => (
        <a href={item.href} class="hidden rounded-full px-4 py-2 text-sm hover:bg-bg-2 sm:block">
          {item.label}
        </a>
      ))
    }
    <button
      type="button"
      data-palette-open
      aria-label="Open command menu"
      class="hidden items-center gap-1 rounded-full px-3 py-2 font-mono text-xs text-muted hover:bg-bg-2 hover:text-fg md:flex"
    >
      <kbd>⌘</kbd><kbd>K</kbd>
    </button>
    <button
      type="button"
      data-palette-open
      aria-label="Open menu"
      class="inline-flex size-9 items-center justify-center rounded-full hover:bg-bg-2 sm:hidden"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
    <ThemeToggle class="rounded-full hover:bg-bg-2" />
    <a
      href={links.email}
      class="rounded-full bg-pop px-4 py-2 text-sm font-semibold text-pop-ink transition-transform hover:scale-105"
    >
      Let's talk
    </a>
  </nav>
</header>
