---
import { links, profile, skillGroups } from "../../data/profile"

const [first, last] = profile.name.split(" ")
const marquee = skillGroups.flatMap((g) => g.skills)
---

<section id="top" class="relative overflow-hidden px-4 pt-32 pb-12 md:px-8 md:pt-40">
  <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-pop/25 blur-3xl"></div>
  <div class="pointer-events-none absolute top-60 -left-40 size-[28rem] rounded-full bg-primary/20 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl">
    <div class="flex flex-wrap items-center gap-3 text-sm">
      {
        profile.openToWork && (
          <span class="inline-flex items-center gap-2 rounded-full border border-line bg-bg-3 px-3 py-1.5">
            <span class="relative flex size-2">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-ok opacity-75" />
              <span class="relative inline-flex size-2 rounded-full bg-ok" />
            </span>
            Open to new roles
          </span>
        )
      }
      <span class="text-muted">{profile.role} · {profile.location}</span>
    </div>

    <h1
      class="hero-name mt-8 font-display leading-[0.82] font-bold tracking-[-0.055em] uppercase"
      aria-label={profile.name}
    >
      <span class="block">{first}</span>
      <span class="block text-transparent [-webkit-text-stroke:2px_var(--fg)]">{last}</span>
    </h1>

    <div class="mt-12 grid items-end gap-10 md:grid-cols-[1.4fr_1fr]">
      <p class="font-display text-3xl leading-tight font-medium tracking-tight md:text-5xl">
        I build the <span class="rounded-xl bg-pop px-2 text-pop-ink">systems</span> underneath
        the product.
      </p>
      <div>
        <p class="text-lg text-muted">{profile.tagline}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="#work"
            class="rounded-full bg-fg px-6 py-3 font-semibold text-bg transition-transform hover:scale-105"
          >
            See my work ↓
          </a>
          <a
            href={links.github}
            class="rounded-full border border-line-strong px-6 py-3 font-semibold transition-colors hover:border-fg"
          >
            GitHub ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="-rotate-1 border-y border-pop-ink/10 bg-pop py-4 text-pop-ink" aria-label="Skills">
  <div class="marquee flex w-max gap-8 font-display text-2xl font-semibold tracking-tight md:text-3xl">
    {
      [0, 1].map((copy) => (
        <ul class="flex shrink-0 gap-8" aria-hidden={copy === 1 ? "true" : undefined}>
          {marquee.map((s) => (
            <li class="flex items-center gap-8 whitespace-nowrap">
              {s}
              <span aria-hidden="true">✦</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .hero-name {
    font-size: clamp(4.5rem, 17vw, 15rem);
  }
  .marquee {
    animation: marquee 40s linear infinite;
  }
  .marquee:hover {
    animation-play-state: paused;
  }
  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - 1rem));
    }
  }
</style>
