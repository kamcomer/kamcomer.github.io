---
import { links, projects, social } from "../../data/profile"

interface Command {
  label: string
  group: string
  href?: string
  action?: "copy-email" | "toggle-theme"
  hint?: string
}

const commands: Command[] = [
  { group: "Navigate", label: "Home", href: "/" },
  { group: "Navigate", label: "Selected work", href: "/#work" },
  { group: "Navigate", label: "Journey", href: "/#journey" },
  { group: "Navigate", label: "Resume", href: "/resume/" },
  ...projects.map((p) => ({
    group: "Case studies",
    label: p.title,
    href: `/projects/${p.slug}/`,
    hint: p.kicker,
  })),
  { group: "Connect", label: "Copy email address", action: "copy-email", hint: social.email },
  { group: "Connect", label: "Send an email", href: links.email },
  { group: "Connect", label: "GitHub", href: links.github, hint: `@${social.github}` },
  { group: "Connect", label: "LinkedIn", href: links.linkedin },
  { group: "Settings", label: "Toggle light / dark", action: "toggle-theme" },
  { group: "Settings", label: "View the industrial design", href: "/industrial/", hint: "alt" },
]
---

<dialog
  id="palette"
  aria-label="Command menu"
  class="m-auto mt-[12vh] w-[min(36rem,calc(100vw-2rem))] overflow-hidden rounded-3xl border border-line bg-bg-3 p-0 text-fg shadow-2xl shadow-black/40 backdrop:bg-black/50 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center gap-3 border-b border-line px-5">
    <svg class="size-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>
    <input
      data-palette-input
      type="text"
      placeholder="Type a command or search…"
      aria-label="Search commands"
      aria-controls="palette-list"
      autocomplete="off"
      spellcheck="false"
      class="h-14 w-full bg-transparent outline-none placeholder:text-muted focus-visible:outline-none"
    />
    <kbd class="rounded-md border border-line px-1.5 py-0.5 font-mono text-[10px] text-muted">esc</kbd>
  </div>
  <ul id="palette-list" role="listbox" class="max-h-[50vh] overflow-y-auto p-2">
    {
      commands.map((c, i) => (
        <li
          role="option"
          id={`cmd-${i}`}
          data-cmd
          data-group={c.group}
          data-href={c.href}
          data-action={c.action}
          data-email={c.action === "copy-email" ? social.email : undefined}
          class="flex cursor-pointer items-center justify-between gap-4 rounded-xl px-3 py-2.5 aria-selected:bg-pop aria-selected:text-pop-ink"
        >
          <span>
            <span class="mr-2 text-xs opacity-50">{c.group}</span>
            {c.label}
          </span>
          {c.hint && <span class="truncate text-xs opacity-60">{c.hint}</span>}
        </li>
      ))
    }
    <li data-empty hidden class="px-3 py-6 text-center text-sm text-muted">No matches</li>
  </ul>
  <p data-palette-status role="status" class="sr-only"></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#palette")
  const input = dialog?.querySelector<HTMLInputElement>("[data-palette-input]")
  const status = dialog?.querySelector<HTMLElement>("[data-palette-status]")
  const empty = dialog?.querySelector<HTMLElement>("[data-empty]")
  const items = [...(dialog?.querySelectorAll<HTMLElement>("[data-cmd]") ?? [])]

  if (dialog && input && status && empty) {
    let active = 0
    const visible = () => items.filter((el) => !el.hidden)

    const select = (index: number) => {
      const list = visible()
      if (!list.length) return
      active = (index + list.length) % list.length
      for (const el of items) el.setAttribute("aria-selected", "false")
      const el = list[active]
      el.setAttribute("aria-selected", "true")
      input.setAttribute("aria-activedescendant", el.id)
      el.scrollIntoView({ block: "nearest" })
    }

    const filter = () => {
      const q = input.value.trim().toLowerCase()
      for (const el of items) {
        el.hidden = q !== "" && !el.textContent?.toLowerCase().includes(q)
      }
      empty.hidden = visible().length > 0
      select(0)
    }

    const open = () => {
      input.value = ""
      filter()
      dialog.showModal()
      input.focus()
    }

    const run = async (el: HTMLElement) => {
      const { href, action, email = "" } = el.dataset
      if (action === "copy-email") {
        const hint = el.querySelector("span:last-child")
        try {
          await navigator.clipboard.writeText(email)
          status.textContent = "Email copied"
          if (hint) hint.textContent = "Copied ✓"
          setTimeout(() => {
            dialog.close()
            if (hint) hint.textContent = email
          }, 700)
        } catch {
          window.location.href = `mailto:${email}`
        }
        return
      }
      if (action === "toggle-theme") {
        document.querySelector<HTMLButtonElement>("[data-theme-toggle]")?.click()
        dialog.close()
        return
      }
      if (href) {
        dialog.close()
        window.location.href = href
      }
    }

    input.addEventListener("input", filter)
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault()
        select(active + 1)
      } else if (e.key === "ArrowUp") {
        e.preventDefault()
        select(active - 1)
      } else if (e.key === "Enter") {
        e.preventDefault()
        const el = visible()[active]
        if (el) run(el)
      }
    })
    for (const el of items) {
      el.addEventListener("click", () => run(el))
      el.addEventListener("mousemove", () => select(visible().indexOf(el)))
    }
    // Close when clicking the backdrop
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close()
    })
    for (const btn of document.querySelectorAll("[data-palette-open]")) {
      btn.addEventListener("click", open)
    }
    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault()
        if (dialog.open) dialog.close()
        else open()
      }
    })
  }
</script>
